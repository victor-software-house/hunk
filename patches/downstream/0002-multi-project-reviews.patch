+/** Keep one review tab mounted so its UI, watcher, extensions, and dialogs survive tab switches. */
+export function ReviewTabHost({
+  active,
+  bootstrap,
+  interactive,
+  onOpenNewReviewTab,
+  onQuit,
+  onRegisterShutdown = () => undefined,
+  onReloaded,
+  reviewTabs,
+  sessionBinding,
+  sessionId,
+  startupNoticeResolver,
+  watchRuntime,

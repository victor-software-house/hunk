+        sessionId,
+        inputKind: nextBootstrap.input.kind,
+        title: nextBootstrap.changeset.title,
+        sourceLabel: nextBootstrap.changeset.sourceLabel,
+        fileCount: nextBootstrap.changeset.files.length,
